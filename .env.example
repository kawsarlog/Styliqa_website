# ── Supabase (same project as KawsarLog — Styliqa uses table styliqa_blog_posts)
# Required on Vercel for public blog + admin.
VITE_SUPABASE_URL=https://omoyuvvcjvtkkccizbbz.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
# Service role key — required for /api/admin/* (bypasses RLS). Never expose to the browser.
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ── Admin login
# Client checks SHA-256 of the pasted token against js/config.js (and this env on the server).
# Set the hash of your plain token (password manager only — never put the plain token in git/Vercel):
VITE_ADMIN_TOKEN_HASH=b9eb440904430f28217d62b87ca01e6a215361b50d6dc4641c4f8d84a7634d45

# ── Cloudflare R2 (hero / in-article image uploads via /api/r2-upload-url)
# Reuse the same R2 account as KawsarLog if you want; uploads go under styliqa/hero/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kawsarlog
R2_PUBLIC_URL=https://assets.kawsarlog.com

# ── SQL (one-time in Supabase SQL editor)
# Run supabase_styliqa_blog_posts.sql so table styliqa_blog_posts exists.
# Prefer https://www.styliqa.com/admin (apex styliqa.com 308-redirects to www).
